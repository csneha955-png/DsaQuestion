#include<bits/stdc++.h>
using namespace std;
int main(){
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        string s;
        cin>>s;
        int cnt=0;
        int cnt1=0;
        int maxi=-1;
        for(int i=0;i<n;i++){
            if(s[i]=='.'){
                cnt++;
                cnt1++;
            }
             else cnt=0;
            maxi=max(maxi,cnt);
        }
        if(maxi>=3)cout<<"2"<<endl;
        else cout<<cnt1<<endl;
    }
}
