#include<bits/stdc++.h>
using namespace std;
int main(){
    int t;
    cin>>t;
    while(t--){
        int l;
        cin>>l;
        int r;
        cin>>r;
        int k;
        cin>>k;
        if((l==r)&&(k>=0) &&(l!=1)){
            cout<<"YES"<<endl;
            continue;
        }
        if((l%2!=0 && r%2==0 && (k>= (r-l)/2 +1))||(r%2!=0 && l%2==0)&& (k>= (r-l)/2 +1)){
                    cout<<"YES"<<endl;
                    continue;
        }
        else if((l%2==0)&&(r%2==0)&&(k>= (r-l)/2)){
            cout<<"YES"<<endl;
                    continue;
        }
        else if((l%2!=0)&&(r%2!=0)&&(k>= (r-l)/2 +1)){
            cout<<"YES"<<endl;
                    continue;
        }
        else cout<<"NO"<<endl;
    }
}
