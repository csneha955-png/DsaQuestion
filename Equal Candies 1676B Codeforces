#include<bits/stdc++.h>
using namespace std;
int main(){
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        int arr[n];
        for(int i=0;i<n;i++){
            cin>>arr[i];
        }
        if(n==1){
            cout<<n-1<<endl;
            continue;
        }
        for(int i = 0; i < n-1; i++) {
            for(int j = 0; j < n-i-1; j++) {
            if(arr[j] > arr[j+1]) {
            int temp = arr[j];
            arr[j] = arr[j+1];
            arr[j+1] = temp;
        }
    }
}
        if(arr[0]==arr[n-1]){
            cout<<0<<endl;
            continue;
        }
        long long sum=0;
        int m=arr[0];
        for(int i=0;i<n;i++){
            sum+=arr[i]-m;
        }
        cout<<sum<<endl;
    }
}
