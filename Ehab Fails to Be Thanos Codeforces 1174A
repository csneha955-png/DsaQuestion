#include<bits/stdc++.h>
using namespace std;
int main(){
    int n;
    cin>>n;
    vector<int> arr(2*n);
    for(int i=0;i<2*n;i++){
        cin>>arr[i];
    }
    long long s1=0,s2=0;
    for(int i=0;i<n;i++){
        s1+=arr[i];
        s2+=arr[i+n];
    }
    if(s1!=s2){
        for(int i=0;i<2*n;i++){
            cout<<arr[i]<<" ";
        }
        return 0;
    }
    bool check=false;
    int idx=-1;
    for(int i=0;i<n;i++){
        for(int j=n;j<2*n;j++){
        if(arr[i]!=arr[j]){
            check=true;
            swap(arr[i],arr[j]);
            break;
        }
        }
        if(check)break;
    }
    if(check){
        for(int i=0;i<2*n;i++){
            cout<<arr[i]<<" ";
        }
    }
    else cout<<"-1"<<endl;
}
