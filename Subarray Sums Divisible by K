class Solution {
public:
    int subarraysDivByK(vector<int>& nums, int k) {
        int n=nums.size();
        int sum=0;
        int cnt=0;
        unordered_map<int,int>mp;
        mp[0]=1;
        for(int i=0;i<n;i++){
            sum+=nums[i];
            int l=sum%k;
            if(l<0)l+=k;
            if(mp.count(l)){
                cnt+=mp[l];
            }
                mp[l]++;
        }
        return cnt;
    }
};
