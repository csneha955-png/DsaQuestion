#include<bits/stdc++.h>
using namespace std;
int main(){
    int t;
    cin>>t;
    while(t--){
        string s;
        cin>>s;
        int n=s.size();
        if(n==1){
            cout<<"0"<<endl;
            continue;
        }
        unordered_map<char,int>mp;
        for(int i=0;i<n;i++){
            mp[s[i]]++;
        }
        int total=0;
        for(auto it:mp){
            if(it.second>=2){
                total+=2;
            }
            else{
                total+=1;
            }
        }
        cout<<total/2<<endl;
    }
}
