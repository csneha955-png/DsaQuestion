#include<bits/stdc++.h>
using namespace std;
int main(){
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        int k;
        cin>>k;
        vector<int>arr(n);
        for(int i=0;i<n;i++){
            cin>>arr[i];
        }
    
        bool sorted=true;
        if(k==1){
        for(int i=0;i<n-1;i++){
            if(arr[i]>arr[i+1]){
            sorted=false;
            break;
            }
        }
        }
        if(sorted){
            cout<<"YES"<<endl;
        }
        else cout<<"NO"<<endl;
    }
}
