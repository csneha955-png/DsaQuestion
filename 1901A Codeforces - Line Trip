#include<bits/stdc++.h>
using namespace std;
int main(){
    int t;
    cin>>t;
    while(t--){
        int n,x;
        cin>>n>>x;
        vector<int>arr(n);
        for(int i=0;i<n;i++){
            cin>>arr[i];
        }
        vector<int>ans;
        ans.push_back(arr[0]);
        for(int i=1;i<n;i++){
            ans.push_back(arr[i]-arr[i-1]);
        }
        ans.push_back(2*(x-arr[n-1]));
        int maxi=-1;
        for(int i=0;i<ans.size();i++){
            maxi=max(maxi,ans[i]);
        }
        cout<<maxi<<endl;
    }
}
