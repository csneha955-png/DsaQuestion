#include<bits/stdc++.h>
using namespace std;
int main(){
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        string s;
        cin>>s;
        for(int i=0;i<n;i++){
            s[i]=tolower(s[i]);
        }
        stack<char>st;
        st.push(s[0]);
        for(int i=1;i<n;i++){
            if(s[i]!=st.top()){
                st.push(s[i]);
            }
        }
        string ans="";
        while(st.size()>0){
            ans+=st.top();
            st.pop();
        }
        reverse(ans.begin(),ans.end());
        if(ans=="meow") cout<<"YES"<<endl;
        else cout<<"NO"<<endl;
    }
}
